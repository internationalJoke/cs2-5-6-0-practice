# Copy to .env and fill in. Used by docker compose.

# Claude login for the container (subscription OAuth token, NOT an API key).
# Generate on your Mac with:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Folder on your machine that Claude may work in (mounted at /workspace). Use a scratch folder.
WORKSPACE=./workspace

# Optional: require ?token=... in the browser. Generate with: openssl rand -hex 16
AUTH_TOKEN=

# Optional: JSON array overriding the permission flags passed to `claude -p`, e.g.
# CLAUDE_PERMISSION_ARGS=["--dangerously-skip-permissions"]
CLAUDE_PERMISSION_ARGS=
